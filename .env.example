# Re-Deploy 部署环境变量样例
# 使用方式：拷贝为 .env 后修改，`docker compose up -d` 会自动读取
#
# ===== 必填 =====

# 运维 Token（Jenkins 等外部调用者用它请求 /api/deploy）
# 生产环境务必改成强随机值
REDEPLOY_ADMIN_TOKEN=changeme

# ===== 可选（留空即使用默认） =====

# SSH 私钥加密密钥（Base64, 16/24/32 字节 → AES-128/192/256）
# 留空 → 容器首启自动生成并在启动日志打印，请务必保存下来
REDEPLOY_SSH_ENCRYPTION_KEY=

# 钉钉告警
REDEPLOY_DINGTALK_ENABLED=false
REDEPLOY_DINGTALK_WEBHOOK_URL=
# notify-mode: failure-only | all
REDEPLOY_DINGTALK_NOTIFY_MODE=failure-only

# 保留策略（天）
REDEPLOY_LOG_RETENTION_DAYS=7
REDEPLOY_HISTORY_RETENTION_DAYS=7

# JVM 参数（默认 -Xms256m -Xmx512m）
JAVA_OPTS=-Xms256m -Xmx512m
